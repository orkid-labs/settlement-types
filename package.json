{
  "name": "@orkid-labs/settlement-types",
  "version": "0.1.0",
  "description": "TypeScript types for cross-chain settlement intents and Hedera settlement targets",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "settlement",
    "cross-chain",
    "hedera",
    "typescript",
    "types",
    "intents",
    "defi",
    "orkid-labs"
  ],
  "author": "Orkid Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/orkid-labs/settlement-types.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  }
}
